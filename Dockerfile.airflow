# Берём Spark-дистрибутив из того же образа, что используется в кластере,
# чтобы версии клиента и кластера гарантированно совпадали.
FROM apache/spark:3.5.3-python3 AS spark

# Python-тег должен совпадать с Python в spark-образе (см. проверку в README ниже).
FROM apache/airflow:2.9.2-python3.8

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=spark /opt/spark /opt/spark
ENV SPARK_HOME=/opt/spark
ENV PATH="/opt/spark/bin:${PATH}"

USER airflow
RUN pip install --no-cache-dir \
    apache-airflow-providers-apache-spark \
    pyspark==3.5.3

# Проверка (docker run --rm <image> python3 --version) — версия Python
# на driver (Airflow) и на executors (Spark worker) должна совпадать по minor.